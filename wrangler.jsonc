{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rockwell-main-website",
  "main": "src/index.js",
  "compatibility_date": "2026-05-02",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    {
      "binding": "WALL_BUCKET",
      "bucket_name": "memorywall"
    }
  ],
  "vars": {
    "R2_PUBLIC_URL": "https://pub-ebde801fc81a49ab89f132d360724caf.r2.dev"
  }
}
